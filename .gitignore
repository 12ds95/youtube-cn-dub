# ─── Python ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ─── 虚拟环境 ─────────────────────────────────────
venv/
.venv/
env/

# ─── Whisper / TTS 大模型（体积大，不入库）───────────
models/*
# 例外: 小型可分发模型 (duration estimator v6 LightGBM, ~290KB)
!models/duration_estimator_lgbm.txt
!models/duration_estimator_lgbm_features.json

# ─── 视频处理输出（每次运行生成）─────────────────────
output/

# ─── 用户配置（含 API Key 等敏感信息）───────────────
config.json
config.resume.json
config.scratch.json

# ─── macOS ────────────────────────────────────────
.DS_Store
._*

# ─── IDE / 编辑器 ─────────────────────────────────
.vscode/
.idea/
.qoder/
*.swp
*.swo
*~

# ─── 其他 ─────────────────────────────────────────
*.log
.env
*.bak
bin/
